# Google Calendar (flux iCal public, lecture seule)
#
# Étapes pour connecter un agenda Google au site :
#
# 1. Google Agenda → créer un nouvel agenda dédié au club.
#    (calendar.google.com → barre gauche → + à côté de « Autres agendas »
#     → Créer un agenda)
#
# 2. Paramètres de cet agenda → section « Autorisations d'accès aux événements »
#    → cocher « Rendre disponible publiquement »
#    → garder « Afficher tous les détails » dans le menu déroulant
#      (sinon le flux ne contient que "Busy", sans titre ni lieu).
#
# 3. Toujours dans les paramètres, section « Intégrer l'agenda »,
#    copier l'« ID de l'agenda » (se termine par @group.calendar.google.com
#    pour un agenda créé, ou ton email pour l'agenda principal).
#    Le coller ci-dessous.
#
# 4. Pour permettre à d'autres membres du bureau d'ajouter/éditer des events :
#    section « Partager avec des personnes et des groupes » → ajouter
#    leur email avec le droit « Apporter des modifications aux événements ».
#    Ils éditeront depuis leur propre app Google Agenda (mobile ou desktop).
#
# Les events sont mis en cache côté serveur pendant 1h
# (voir lib/google-calendar.ts). Pour rafraîchir plus vite,
# redéployer ou appeler revalidateTag('calendar').

GOOGLE_CALENDAR_ID=

# Accès temporaire à la page /stages (12 caractères minimum)
STAGES_PASSWORD=

# Synchronisation horaire des stages
CRON_SECRET=

# Supabase (les deux premières valeurs peuvent être exposées au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret serveur uniquement — ne jamais préfixer avec NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
