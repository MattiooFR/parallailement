# Base du site : pile appdb-parallailement sur le Hetzner (~/infra/apps-db/parallailement)
# Les deux premières valeurs peuvent être exposées au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://db.parallailement.fr
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret serveur uniquement — ne jamais préfixer avec NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site, utilisée dans les liens des emails
NEXT_PUBLIC_SITE_URL=https://parallailement.fr

# Clé Bearer des tâches horaires Vercel (stages + rappels)
CRON_SECRET=

# Envoi des emails (API SmartLetter, compatible Resend). Sans ces deux valeurs,
# les emails restent en file.
SMARTLETTER_API_KEY=
EMAIL_FROM="Parallailement <club@parallailement.fr>"
EMAIL_REPLY_TO=
